# The repository is not a venv (build spec section 3.3).
.venv/

# Python bytecode, editable install metadata, and tool caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Artifact store: every stage output is regenerable from the manifests.
experiments/results/

# Inherited raw CSVs stay out of git (5 MB rule); P1 commits the Parquet compaction.
legacy_salvage/data/*.csv

# The quarantined 570 row augmented dataset (data/quarantine/README.md). It stays on disk
# inside the frozen v1 tree, but its two large CSVs (67.8 MB and 14.5 MB) break the 5 MB
# rule and nothing reads them, so git does not carry them.
v1_legacy/augmentation_physics_fixed/load_displacement_full_aug.csv
v1_legacy/augmentation_physics_fixed/crack_evolution_full_aug.csv

# report/tables/*.tex is deliberately NOT ignored. Those fragments are generated by
# scripts/make_data_card.py from the artifact store, but they are small text files and
# committing them is what lets the LaTeX build run in CI without the artifact store, and
# what lets tests/test_data_card.py catch a card that has drifted from the pipeline. The
# figures are the opposite case: PDFs, regenerated by report/figures_src/make_figures.py.

# LaTeX build products and latexmk intermediates
report/main.pdf
report/Report.pdf
report/*.pptx
report/figures/*.pdf
report/test_sample_0212.png
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
report/*.synctex.gz
report/*.toc

# Editor and OS noise
*.bak
.DS_Store
Thumbs.db
.vscode/
.idea/

# docs/media/ufem_lab.gif is committed deliberately (build spec section 15.1).
