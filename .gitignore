# The repository is not a venv (build spec section 3.3).
.venv/

# Python bytecode, editable install metadata, and tool caches
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Artifact store: every stage output is regenerable from the manifests.
experiments/results/

# Inherited raw CSVs stay out of git (5 MB rule); P1 commits the Parquet compaction.
legacy_salvage/data/*.csv

# The quarantined 570 row augmented dataset (data/quarantine/README.md). It stays on disk
# inside the frozen v1 tree, but its two large CSVs (67.8 MB and 14.5 MB) break the 5 MB
# rule and nothing reads them, so git does not carry them.
v1_legacy/augmentation_physics_fixed/load_displacement_full_aug.csv
v1_legacy/augmentation_physics_fixed/crack_evolution_full_aug.csv

# report/tables/*.tex and report/figures/*.pdf are deliberately NOT ignored. Both are
# generated from the artifact store (the fragments by scripts/make_data_card.py, the figures
# by report/figures_src/make_figures.py), and committing both is what lets report.yml build
# the PDF on a TeX Live container that has no Python stack and no artifact store. That is
# exactly what report.yml's header claims, and ignoring the figures while claiming it is what
# broke the workflow: latexmk died on a missing fig_E_collinearity.pdf. The whole figure set
# is 556 KB, well inside the 5 MB rule, and the staleness gate in tests/test_data_card.py is
# what keeps the committed copies honest. The PDF is the opposite case, a large binary no
# test can meaningfully diff, so it stays ignored and ships as a CI artifact.

# LaTeX build products and latexmk intermediates
report/main.pdf
report/Report.pdf
# The renamed copy scripts/make_release.py stages for the release upload.
report/ufem-2.0-report-v*.pdf
report/*.pptx
report/test_sample_0212.png
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
report/*.synctex.gz
report/*.toc

# Editor and OS noise
*.bak
.DS_Store
Thumbs.db
.vscode/
.idea/

